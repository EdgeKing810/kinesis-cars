---
import Layout from '../layouts/Layout.astro';
import DriverVerification from '../components/react/DriverVerification.tsx';
---
<Layout title="Driver verification — Kinesis Cars" description="Submit your driver license for verification.">
	<Fragment slot="head">
		<script is:inline>
			// Requires a session to submit driver verification.
			try {
				if (!localStorage.getItem('kinesis.auth')) {
					window.location.replace('/login?next=/verification');
				}
			} catch (e) {
				/* ignore */
			}
		</script>
	</Fragment>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<DriverVerification client:load />
	</section>
</Layout>
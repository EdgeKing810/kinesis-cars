---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/react/RegisterForm.tsx';
---
<Layout title="Create an account — Kinesis Cars" description="Join Kinesis Cars as a client or merchant.">
	<section class="mx-auto flex max-w-6xl px-4 py-16 sm:px-6">
		<div class="mx-auto w-full max-w-lg">
			<div class="rounded-3xl border border-white/10 bg-slate-900/50 p-8">
				<a href="/" class="mb-8 flex items-center justify-center gap-2.5">
					<img src="/favicon.svg" alt="Kinesis Cars" width="28" height="28" class="h-7 w-7 rounded-lg" />
					<span class="text-lg font-semibold tracking-tight text-white">Kinesis<span class="text-brand-500">Cars</span></span>
				</a>

				<h1 class="text-center text-2xl font-bold tracking-tight text-white">Create your account</h1>
				<p class="mt-2 text-center text-sm text-slate-400">Choose how you'll use Kinesis Cars.</p>

				<RegisterForm client:load />

				<p class="mt-6 text-center text-sm text-slate-400">
					Already have an account?
					<a href="/login" class="btn btn-link btn-sm px-0 text-brand-400 hover:text-brand-300 ml-2">Sign in</a>
				</p>
			</div>
		</div>
	</section>
</Layout>
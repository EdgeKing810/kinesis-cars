---
import Layout from '../layouts/Layout.astro';
import PaymentsManager from '../components/react/PaymentsManager.tsx';
---
<Layout title="Payments — Kinesis Cars" description="View your payment transactions.">
	<Fragment slot="head">
		<script is:inline>
			// Requires a session to view payments.
			try {
				if (!localStorage.getItem('kinesis.auth')) {
					window.location.replace('/login?next=/payments');
				}
			} catch (e) {
				/* ignore */
			}
		</script>
	</Fragment>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<PaymentsManager client:load />
	</section>
</Layout>
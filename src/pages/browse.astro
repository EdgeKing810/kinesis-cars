---
import Layout from '../layouts/Layout.astro';
import BrowseCars from '../components/react/BrowseCars.tsx';
---
<Layout title="Browse cars — Kinesis Cars" description="Browse the live fleet of verified rental vehicles on Kinesis Cars.">
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="mb-8">
			<p class="text-sm font-semibold uppercase tracking-widest text-brand-500">Browse the fleet</p>
			<h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Find your next rental</h1>
			<p class="mt-3 max-w-xl text-slate-400">
				Filter by make, body, fuel or location, search by name, and sort by price or recency.
			</p>
		</div>

		<BrowseCars client:load />
	</section>
</Layout>
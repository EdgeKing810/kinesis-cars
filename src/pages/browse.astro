---
import Layout from '../layouts/Layout.astro';

const filters = ['Make', 'Body type', 'Transmission', 'Fuel', 'Price range'];
---
<Layout title="Browse cars — Kinesis Cars" description="Browse the live fleet of verified rental vehicles on Kinesis Cars.">
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
			<div>
				<p class="text-sm font-semibold uppercase tracking-widest text-brand-500">Browse the fleet</p>
				<h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Find your next rental</h1>
				<p class="mt-3 max-w-xl text-slate-400">
					Vehicle listings are wired to Kinesis API. Search, filter and booking are coming in the
					next iteration.
				</p>
			</div>
		</div>

		<!-- Filter bar placeholder -->
		<div class="mt-8 flex flex-wrap gap-3">
			{filters.map((label) => (
				<button
					type="button"
					class="btn btn-outline btn-info btn-sm"
				>
					{label}
				</button>
			))}
		</div>

		<!-- Vehicle grid skeleton -->
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{[...Array(6)].map((_, i) => (
				<article class="group overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50">
					<div class="flex h-44 items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-16 w-16 text-slate-700">
							<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>
						</svg>
					</div>
					<div class="p-5">
						<div class="flex items-center justify-between">
							<h2 class="font-semibold text-white">Vehicle {i + 1}</h2>
							<p class="text-sm font-semibold text-brand-500">$—/day</p>
						</div>
						<p class="mt-1 text-sm text-slate-500">Make · Body · Fuel</p>
						<div class="mt-4 flex items-center justify-between border-t border-white/10 pt-4">
							<p class="text-xs text-slate-500">Awaiting API</p>
							<span class="rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium text-slate-400">Book soon</span>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>
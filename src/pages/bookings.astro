---
import Layout from '../layouts/Layout.astro';
import BookingsManager from '../components/react/BookingsManager.tsx';
---
<Layout title="Bookings — Kinesis Cars" description="View and manage your vehicle bookings.">
	<Fragment slot="head">
		<script is:inline>
			// Requires a session to view bookings.
			try {
				if (!localStorage.getItem('kinesis.auth')) {
					window.location.replace('/login?next=/bookings');
				}
			} catch (e) {
				/* ignore */
			}
		</script>
	</Fragment>
	<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
		<BookingsManager client:load />
	</section>
</Layout>
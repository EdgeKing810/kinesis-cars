---
import Layout from '../layouts/Layout.astro';
---
<Layout>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			<div class="absolute -top-48 left-1/2 h-[28rem] w-[46rem] -translate-x-1/2 rounded-full bg-brand-600/20 blur-3xl" />
			<div class="absolute -bottom-40 -right-24 h-80 w-80 rounded-full bg-slate-500/10 blur-3xl" />
		</div>

		<div class="relative mx-auto max-w-6xl px-4 pb-20 pt-16 text-center sm:px-6 sm:pb-28 sm:pt-24">
			<p class="mx-auto inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand-400">
				Car booking &amp; fleet management
			</p>

			<h1 class="mx-auto mt-6 max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-6xl">
				Rent the right car.
				<span class="bg-gradient-to-r from-brand-400 to-brand-600 bg-clip-text text-transparent ml-2">Every time.</span>
			</h1>

			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
				Kinesis Cars connects you with verified vehicles from trusted merchants. Search, book and
				drive — with secure payments and flexible bookings from start to finish.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
				<a href="/browse" class="btn btn-primary btn-lg shadow-lg shadow-brand-600/25">Browse available cars</a>
			<a href="/register" class="btn btn-outline btn-secondary btn-lg">I'm a merchant</a>
			</div>

			<!-- Search placeholder -->
			<form action="/browse" method="get" class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 text-left sm:grid-cols-[1fr_1fr_1.2fr_auto]">
				<label class="block bg-slate-900 px-5 py-4">
					<span class="text-xs font-medium uppercase tracking-wide text-slate-500">Pickup location</span>
					<input type="text" name="pickup" placeholder="City or airport" class="mt-1 w-full bg-transparent text-sm text-white placeholder:text-slate-600 focus:outline-none" />
				</label>
				<label class="block bg-slate-900 px-5 py-4">
					<span class="text-xs font-medium uppercase tracking-wide text-slate-500">Drop-off location</span>
					<input type="text" name="dropoff" placeholder="City or airport" class="mt-1 w-full bg-transparent text-sm text-white placeholder:text-slate-600 focus:outline-none" />
				</label>
				<label class="block bg-slate-900 px-5 py-4">
					<span class="text-xs font-medium uppercase tracking-wide text-slate-500">Dates</span>
					<input type="text" name="dates" placeholder="Sep 24 – Oct 02" class="mt-1 w-full bg-transparent text-sm text-white placeholder:text-slate-600 focus:outline-none" />
				</label>
				<button type="submit" class="btn btn-primary h-full w-full rounded-none">Search</button>
			</form>
		</div>
	</section>

	<!-- Stats -->
	<section class="border-y border-white/10 bg-slate-900/40">
		<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 text-center sm:px-6 md:grid-cols-4">
			<div>
				<p class="text-3xl font-bold text-white">10k+</p>
				<p class="mt-1 text-sm text-slate-400">Vehicles listed</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">500+</p>
				<p class="mt-1 text-sm text-slate-400">Trusted merchants</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">40+</p>
				<p class="mt-1 text-sm text-slate-400">Cities covered</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">24/7</p>
				<p class="mt-1 text-sm text-slate-400">Support</p>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Everything you need to hit the road</h2>
			<p class="mt-4 text-lg text-slate-400">
				A platform built around verified fleets, flexible bookings and secure payments.
			</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			<div class="rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/15 text-brand-500">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
				</div>
				<h3 class="mt-6 text-lg font-semibold text-white">Vetted fleets</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Every merchant and driver is verified before hitting the platform, so every booking is
					with a trusted partner.
				</p>
			</div>

			<div class="rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/15 text-brand-500">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
				</div>
				<h3 class="mt-6 text-lg font-semibold text-white">Flexible bookings</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Rent for a day, a week or a month. Pick up and drop off where it suits you — manage
					everything from your dashboard.
				</p>
			</div>

			<div class="rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/15 text-brand-500">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
				</div>
				<h3 class="mt-6 text-lg font-semibold text-white">Secure payments</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Payments are handled end-to-end through trusted providers, with full transaction
					tracking on every booking.
				</p>
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="border-y border-white/10 bg-slate-900/40">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Book in three steps</h2>
				<p class="mt-4 text-lg text-slate-400">From search to driving in minutes.</p>
			</div>

			<div class="mt-14 grid gap-6 md:grid-cols-3">
				<div class="relative rounded-2xl border border-white/10 bg-slate-950/60 p-8">
					<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">1</span>
					<h3 class="mt-2 text-lg font-semibold text-white">Browse</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">
						Filter the live fleet by make, body type, fuel and price to find the perfect car.
					</p>
				</div>
				<div class="relative rounded-2xl border border-white/10 bg-slate-950/60 p-8">
					<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">2</span>
					<h3 class="mt-2 text-lg font-semibold text-white">Book</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">
						Choose your dates and locations, pay securely and lock in your rental instantly.
					</p>
				</div>
				<div class="relative rounded-2xl border border-white/10 bg-slate-950/60 p-8">
					<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">3</span>
					<h3 class="mt-2 text-lg font-semibold text-white">Drive</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">
						Pick up your keys and go. Manage every trip from your personal dashboard.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Roles -->
	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
		<div class="grid gap-6 md:grid-cols-2">
			<div class="rounded-3xl border border-white/10 bg-gradient-to-br from-slate-900 to-slate-950 p-8 sm:p-10">
				<h3 class="text-2xl font-bold text-white">Renting as a client</h3>
				<p class="mt-3 text-sm leading-relaxed text-slate-400">
					Get verified once, then book from thousands of vehicles across the platform. Enjoy clear
					pricing, flexible dates and secure payments.
				</p>
				<ul class="mt-6 space-y-3 text-sm text-slate-300">
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Verified drivers &amp; merchants</li>
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Transparent per-day pricing</li>
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Bookings &amp; receipts in one place</li>
				</ul>
				<a href="/register" class="btn btn-outline btn-secondary mt-8">Create an account</a>
			</div>

			<div class="rounded-3xl border border-brand-500/20 bg-gradient-to-br from-brand-500/10 to-slate-950 p-8 sm:p-10">
				<h3 class="text-2xl font-bold text-white">Managing a fleet</h3>
				<p class="mt-3 text-sm leading-relaxed text-slate-400">
					List your vehicles, group them into fleets and control availability with blockouts and
					maintenance windows — all from one dashboard.
				</p>
				<ul class="mt-6 space-y-3 text-sm text-slate-300">
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Create &amp; manage fleets</li>
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Control vehicle availability</li>
					<li class="flex items-center gap-3"><span class="text-brand-500">✓</span> Set pricing &amp; minimum rentals</li>
				</ul>
				<a href="/register" class="btn btn-primary mt-8">Start listing cars</a>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24">
		<div class="relative overflow-hidden rounded-3xl border border-white/10 bg-slate-900/60 px-8 py-16 text-center sm:px-16">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute left-1/2 top-0 h-40 w-[36rem] -translate-x-1/2 rounded-full bg-brand-600/20 blur-3xl" />
			</div>
			<h2 class="relative text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to hit the road?</h2>
			<p class="relative mx-auto mt-4 max-w-2xl text-lg text-slate-400">
				Join Kinesis Cars today — rent your next vehicle or put your fleet to work.
			</p>
			<div class="relative mt-8 flex flex-wrap items-center justify-center gap-4">
				<a href="/register" class="btn btn-primary btn-lg">Get started</a>
				<a href="/browse" class="btn btn-outline btn-info btn-lg">Browse cars</a>
			</div>
		</div>
	</section>
</Layout>
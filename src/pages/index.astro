---
import Layout from '../layouts/Layout.astro';
import FeaturedCars from '../components/react/FeaturedCars.tsx';
---
<Layout>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			<div class="absolute -top-48 left-1/2 h-[28rem] w-[46rem] -translate-x-1/2 rounded-full bg-brand-500/20 blur-3xl" />
			<div class="absolute -bottom-40 -right-24 h-80 w-80 rounded-full bg-slate-500/10 blur-3xl" />
		</div>

		<div class="relative mx-auto max-w-6xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pb-24 sm:pt-28">
			<p class="mx-auto inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand-400">
				Car booking &amp; fleet management
			</p>

			<h1 class="mx-auto mt-6 max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-6xl">
				Rent the right car.
				<span class="bg-gradient-to-r from-brand-400 to-brand-600 bg-clip-text text-transparent ml-2">Every time.</span>
			</h1>

			<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
				Verified vehicles from trusted merchants, with secure payments and flexible bookings — all in
				one place.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
				<a href="/browse" class="btn btn-primary btn-lg shadow-lg shadow-brand-600/25">Browse available cars</a>
				<a href="/register" class="btn btn-outline btn-secondary btn-lg">I'm a merchant</a>
			</div>
		</div>
	</section>

	<!-- Stats -->
	<section class="border-y border-white/10 bg-slate-900/40">
		<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 text-center sm:px-6 md:grid-cols-4">
			<div>
				<p class="text-3xl font-bold text-white">30+</p>
				<p class="mt-1 text-sm text-slate-400">Vehicles listed</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">10+</p>
				<p class="mt-1 text-sm text-slate-400">Fleets on the platform</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">5</p>
				<p class="mt-1 text-sm text-slate-400">Island-wide locations</p>
			</div>
			<div>
				<p class="text-3xl font-bold text-white">24/7</p>
				<p class="mt-1 text-sm text-slate-400">Support</p>
			</div>
		</div>
	</section>

	<!-- Featured cars -->
	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-sm font-semibold uppercase tracking-widest text-brand-500">Fresh off the lot</p>
				<h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Latest on the platform</h2>
			</div>
			<a href="/browse" class="btn btn-outline btn-info">View all cars</a>
		</div>

		<div class="mt-10">
			<FeaturedCars client:load />
		</div>
	</section>

	<!-- Browse by type -->
	<section class="border-y border-white/10 bg-slate-900/40">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<h2 class="text-center text-3xl font-bold tracking-tight text-white sm:text-4xl">Browse by type</h2>
			<p class="mx-auto mt-4 max-w-xl text-center text-slate-400">Jump straight to the category you're after.</p>

			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				<a href="/browse?body=SUV" class="group rounded-2xl border border-white/10 bg-slate-900/50 p-8 text-center transition hover:border-brand-500/40">
					<span class="text-3xl">🚙</span>
					<h3 class="mt-3 font-semibold text-white group-hover:text-brand-300">SUV</h3>
					<p class="mt-1 text-sm text-slate-400">Space for the whole crew</p>
				</a>
				<a href="/browse?body=COUPE" class="group rounded-2xl border border-white/10 bg-slate-900/50 p-8 text-center transition hover:border-brand-500/40">
					<span class="text-3xl">🏎️</span>
					<h3 class="mt-3 font-semibold text-white group-hover:text-brand-300">Sports &amp; coupes</h3>
					<p class="mt-1 text-sm text-slate-400">Built for the open road</p>
				</a>
				<a href="/browse?body=SMALL_CAR" class="group rounded-2xl border border-white/10 bg-slate-900/50 p-8 text-center transition hover:border-brand-500/40">
					<span class="text-3xl">🚗</span>
					<h3 class="mt-3 font-semibold text-white group-hover:text-brand-300">City cars</h3>
					<p class="mt-1 text-sm text-slate-400">Easy parking, easy budget</p>
				</a>
				<a href="/browse?fuel_type=ELECTRIC" class="group rounded-2xl border border-white/10 bg-slate-900/50 p-8 text-center transition hover:border-brand-500/40">
					<span class="text-3xl">⚡</span>
					<h3 class="mt-3 font-semibold text-white group-hover:text-brand-300">Electric</h3>
					<p class="mt-1 text-sm text-slate-400">Silent, instant torque</p>
				</a>
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Book in three steps</h2>
			<p class="mt-4 text-lg text-slate-400">From search to driving in minutes.</p>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-3">
			<div class="relative rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">1</span>
				<h3 class="mt-2 text-lg font-semibold text-white">Browse</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Filter the live fleet by make, body type, fuel and price to find the perfect car.
				</p>
			</div>
			<div class="relative rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">2</span>
				<h3 class="mt-2 text-lg font-semibold text-white">Book</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Choose your dates and locations, pay securely and lock in your rental instantly.
				</p>
			</div>
			<div class="relative rounded-2xl border border-white/10 bg-slate-900/50 p-8">
				<span class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">3</span>
				<h3 class="mt-2 text-lg font-semibold text-white">Drive</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">
					Pick up your keys and go. Manage every trip from your personal dashboard.
				</p>
			</div>
		</div>
	</section>

	<!-- Roles -->
	<section class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
		<div class="grid gap-6 md:grid-cols-2">
			<div class="rounded-3xl border border-white/10 bg-gradient-to-br from-slate-900 to-slate-950 p-8 sm:p-10">
				<h3 class="text-2xl font-bold text-white">Renting as a client</h3>
				<p class="mt-3 text-sm leading-relaxed text-slate-400">
					Get verified once, then book from thousands of vehicles across the platform. Enjoy clear
					pricing, flexible dates and secure payments.
				</p>
				<ul class="mt-6 space-y-3 text-sm text-slate-300">
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Verified drivers &amp; merchants</li>
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Transparent per-day pricing</li>
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Bookings &amp; receipts in one place</li>
				</ul>
				<a href="/register" class="btn btn-outline btn-secondary mt-8">Create an account</a>
			</div>

			<div class="rounded-3xl border border-brand-500/20 bg-gradient-to-br from-brand-500/10 to-slate-950 p-8 sm:p-10">
				<h3 class="text-2xl font-bold text-white">Managing a fleet</h3>
				<p class="mt-3 text-sm leading-relaxed text-slate-400">
					List your vehicles, group them into fleets and control availability with blockouts and
					maintenance windows — all from one dashboard.
				</p>
				<ul class="mt-6 space-y-3 text-sm text-slate-300">
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Create &amp; manage fleets</li>
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Control vehicle availability</li>
					<li class="flex items-center gap-3"><span class="text-brand-400">✓</span> Set pricing &amp; minimum rentals</li>
				</ul>
				<a href="/register" class="btn btn-primary mt-8">Start listing cars</a>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="relative overflow-hidden rounded-3xl border border-white/10 bg-slate-900/60 px-8 py-16 text-center sm:px-16">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute left-1/2 top-0 h-40 w-[36rem] -translate-x-1/2 rounded-full bg-brand-500/20 blur-3xl" />
			</div>
			<h2 class="relative text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to hit the road?</h2>
			<p class="relative mx-auto mt-4 max-w-xl text-lg text-slate-400">
				Join Kinesis Cars today — rent your next vehicle or put your fleet to work.
			</p>
			<div class="relative mt-8 flex flex-wrap items-center justify-center gap-4">
				<a href="/register" class="btn btn-primary btn-lg">Get started</a>
				<a href="/browse" class="btn btn-outline btn-info btn-lg">Browse cars</a>
			</div>
		</div>
	</section>
</Layout>